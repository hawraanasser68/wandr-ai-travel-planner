# ── Database ────────────────────────────────────────────────────────────────
# Used by SQLAlchemy async engine and Alembic migrations
# For Docker: use "db" as the host (docker-compose service name)
# For local dev: use "localhost"
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_planner

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "groq" or "gemini"
LLM_PROVIDER=groq

# ── Groq (FREE — no credit card required) ────────────────────────────────────
# 1. Go to https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_...
FAST_MODEL=llama-3.1-8b-instant
SYNTH_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (FREE — no credit card required) ────────────────────────────
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" → copy it here
GOOGLE_API_KEY=AIza...

# ── Weather (openweathermap.org — free plan, no card required) ────────────────
# 1. Sign up at https://openweathermap.org/appid
# 2. Go to API Keys tab → copy the default key
OPENWEATHERMAP_API_KEY=your-key-here

# ── Email webhook (resend.com — free plan: 3,000 emails/month) ────────────────
# 1. Sign up at https://resend.com
# 2. Go to API Keys → Create API Key
RESEND_API_KEY=re_...
# Use onboarding@resend.dev for testing without a verified domain
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── API Ninjas (free — api-ninjas.com → Sign up → profile → Show API Key) ───
API_NINJAS_KEY=your-key-here

# ── Travelpayouts flight prices (free — travelpayouts.com) ───────────────────
TRAVELPAYOUTS_TOKEN=

# ── RapidAPI (Sky Scrapper — Skyscanner data) ─────────────────────────────────
# Subscribe free at rapidapi.com → search "Sky Scrapper"
RAPIDAPI_KEY=your-key-here

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
# Sign up free at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-travel-planner
LANGCHAIN_API_KEY=lsv2_...
